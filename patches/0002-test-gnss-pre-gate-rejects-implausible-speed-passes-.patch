                     '/gnss/fix',
                     '/clock',
diff --git a/fusioncore_ros/src/fusion_node.cpp b/fusioncore_ros/src/fusion_node.cpp
index 91f6e58..4f36fe1 100644
--- a/fusioncore_ros/src/fusion_node.cpp
+++ b/fusioncore_ros/src/fusion_node.cpp
@@ -2260,6 +2260,7 @@ private:
       case fusioncore::GnssRejectionReason::VDOP_HIGH:       return "VDOP_HIGH";
       case fusioncore::GnssRejectionReason::MIN_SATS:        return "MIN_SATS";
       case fusioncore::GnssRejectionReason::CHI2_FAILED:     return "CHI2_FAILED";
+      case fusioncore::GnssRejectionReason::SPEED_IMPLAUSIBLE: return "SPEED_IMPLAUSIBLE";
       case fusioncore::GnssRejectionReason::DELAY_TOO_LARGE: return "DELAY_TOO_LARGE";
       default:                                                return "NOT_PROCESSED";
     }
